{
  "tools": [
    {
      "name": "claude",
      "required": true,
      "default": true,
      "check": ["claude", "--version"],
      "install": {
        "type": "script",
        "url": "https://claude.ai/install.sh",
        "shell": "bash",
        "args": ["stable"]
      }
    },
    {
      "name": "t3",
      "required": false,
      "default": true,
      "check": [],
      "install": {
        "type": "mac-app-feed",
        "feed": "https://github.com/pingdotgg/t3code/releases/latest/download/latest-mac.yml",
        "zip_suffix": {"arm64": "-arm64.zip", "x86_64": "-x64.zip"},
        "app_glob": "T3 Code*.app"
      }
    },
    {
      "name": "gws",
      "required": false,
      "default": false,
      "check": ["gws", "--version"],
      "install": {
        "type": "archive-binary",
        "version": "0.22.5",
        "assets": {
          "arm64": {
            "url": "https://github.com/googleworkspace/cli/releases/download/v0.22.5/google-workspace-cli-aarch64-apple-darwin.tar.gz",
            "sha256": "1d2a9ffd5bc9b2c2c4b48630daf082fad13d9e57d741988a2c248eed562f7dac"
          },
          "x86_64": {
            "url": "https://github.com/googleworkspace/cli/releases/download/v0.22.5/google-workspace-cli-x86_64-apple-darwin.tar.gz",
            "sha256": "51f9bd731404d4bba26c36e2e30dd68c56dccd1f834c01252cb0b14d6a6544b2"
          }
        },
        "binary": "gws",
        "dest": "~/.local/bin/gws"
      }
    },
    {
      "name": "codex",
      "required": false,
      "default": false,
      "check": ["codex", "--version"],
      "install": {
        "type": "script",
        "url": "https://chatgpt.com/codex/install.sh",
        "shell": "sh"
      }
    }
  ]
}
