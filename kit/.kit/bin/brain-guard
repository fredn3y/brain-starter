#!/usr/bin/env python3
"""Claude Code PreToolUse hook entry point (see brainkit/guard.py)."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

try:
    from brainkit.guard import main  # noqa: E402
except Exception:  # a broken install must not block every tool call
    sys.exit(0)

if __name__ == "__main__":
    sys.exit(main())
