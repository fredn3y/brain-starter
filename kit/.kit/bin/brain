#!/usr/bin/env python3
"""Entry point for the `brain` command (symlinked into ~/.local/bin by the installer)."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

if sys.version_info < (3, 9):
    sys.stderr.write("brain needs Python 3.9 or newer (install Apple's Command Line Tools).\n")
    sys.exit(2)

from brainkit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
