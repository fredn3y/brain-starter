{
  "permissions": {
    "deny": [
      "Bash(gws gmail users messages send *)",
      "Bash(gws gmail users drafts send *)",
      "Bash(gws * +send *)",
      "Bash(gws * +send)",
      "Bash(gws * +reply *)",
      "Bash(gws * +reply)",
      "Bash(gws * +reply-all *)",
      "Bash(gws * +forward *)",
      "Bash(gws auth export *)",
      "Bash(security find-generic-password *)",
      "Bash(security dump-keychain *)",
      "Read(~/.config/gws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/Library/Keychains/**)",
      "Bash(gws * send *)",
      "Bash(gws * send)",
      "Bash(security * find-generic-password *)",
      "Bash(security -i)",
      "Bash(security -i *)",
      "Bash(brain _apply *)",
      "Bash(* _apply *)",
      "Bash(sudo *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm * -r *)",
      "Bash(rm * -R *)",
      "Bash(rm * -rf *)",
      "Bash(rm * -fr *)",
      "Bash(rm --recursive *)",
      "Bash(rm * --recursive *)",
      "Bash(/bin/rm -rf *)",
      "Bash(/bin/rm -r *)",
      "Bash(git reset --hard)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)"
    ],
    "allow": [
      "Bash(brain doctor)",
      "Bash(brain doctor *)",
      "Bash(brain catchup --dry-run)",
      "Bash(brain brief --detach)",
      "Bash(brain slack whoami)",
      "Bash(brain slack channels)",
      "Bash(brain slack recent)",
      "Bash(brain slack recent *)",
      "Bash(brain slack search *)",
      "Bash(brain slack thread *)",
      "Bash(brain google status)",
      "Bash(brain secret check *)",
      "Bash(brain secret list)",
      "Bash(brain schedule status)",
      "Bash(brain update --check)",
      "Bash(brain tools status)",
      "Bash(gws gmail +triage *)",
      "Bash(gws gmail +read *)",
      "Bash(gws calendar +agenda *)",
      "Bash(gws drive files list *)",
      "Bash(gws drive files get *)",
      "Bash(gws drive files export *)",
      "Bash(gws gmail users threads get *)",
      "Bash(gws gmail users messages get *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.kit/bin/brain",
            "args": ["_session-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.kit/bin/brain-guard",
            "args": []
          }
        ]
      }
    ]
  }
}
